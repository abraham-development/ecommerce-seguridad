# Example values for local validation and GitHub Actions configuration.
# Do not put real secrets in this file.

AFCR_RESOURCE_SUFFIX=afcr01
POSTGRES_ADMIN_LOGIN=afcradmin
POSTGRES_ADMIN_PASSWORD=replace-with-secure-password
ENTRA_EXTERNAL_ID_CLIENT_ID=replace-with-entra-client-id
ENTRA_EXTERNAL_ID_CLIENT_SECRET=replace-with-entra-client-secret
ENTRA_EXTERNAL_ID_ISSUER=https://replace-with-issuer.example.com
NEXTAUTH_SECRET=replace-with-long-random-secret

# Runtime app settings. In Azure these are supplied through Key Vault references.
DATABASE_URL=postgresql://user:password@host:5432/afcr_ecommerce?sslmode=require
AZURE_STORAGE_ACCOUNT_NAME=replace-with-storage-account
AZURE_STORAGE_CONTAINER_NAME=product-images
AZURE_STORAGE_CONNECTION_STRING=replace-with-storage-connection-string
